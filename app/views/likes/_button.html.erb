<div id="<%= dom_id(tweet, :like_button) %>" class="inline-block">
  <% if (like = Current.user&.likes&.find_by(tweet_id: tweet.id)) %>
    <%= link_to "❤️", tweet_like_path(tweet, like), data: { turbo_method: :delete }, class: "text-red-500 font-bold" %>
  <% else %>
    <%= link_to "🤍", tweet_likes_path(tweet), data: { turbo_method: :post }, class: "text-gray-500 hover:text-red-500" %>
  <% end %>
</div>