<% if flash.any? %>
      <% flash.each do |type, message| %>
        <% if type == "notice" %>
          <div
              class="fixed bottom-10 right-10 border border-blue-500 bg-white shadow-xl rounded-lg p-4 px-16"
              data-controller="flash"
          >
              <div>
                <%= message %>
              </div>
          </div>
        <% else %>
          <div
            class="fixed bottom-10 right-10 border border-red-500 bg-white shadow-xl rounded-lg p-4 px-16"
            data-controller="flash"
          >
            <div>
              <%= message %>
            </div>
          </div>
        <% end %>
      <% end %>
<% end %>