<div id="<%= dom_id(tweet) %>" class="p-4 rounded-xl shadow-lg border border-gray-100 bg-white">
  <div class="flex justify-between">
    <span class="text-xs text-gray-500">by <%= display_author(tweet) %></span>
    <%= link_to "𝕩", tweet_path(tweet), data: { turbo_method: :delete } if Current.user&.is_tweet_owner?(tweet) %>
  </div>

  <p class="text-gray-800 whitespace-pre-wrap my-2"><%= tweet.body %></p>

  <div class="mt-3 flex items-center justify-between text-xs text-gray-400">
    <span><%= time_ago_in_words(tweet.created_at) %> temu</span>

    <div class="flex items-center gap-1.5">
      <%= render "likes/button", tweet: tweet %>

      <%= render "likes/counter", tweet: tweet %>
    </div>
  </div>
  <%= turbo_frame_tag "comments" do %>
  <%= link_to "💬 Show comments", tweet_comments_path(tweet), class: "text-blue-500 hover:underline" %>
  <% end %>
</div>