<main class="max-w-xl mx-auto p-8">
  <h2 class="text-2xl font-semibold">Feed</h2>

  <div class="p-4 rounded border shadow-xl border-gray-200 bg-white">
    <%= render "form", model: @tweet %>

  </div>

  <div id="tweets" class="space-y-4 my-8">
    <% @tweets.each do |tweet| %>
      <%= render tweet %>
    <% end %>
  </div>

</main>