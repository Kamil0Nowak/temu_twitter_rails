<main class="max-w-xl mx-auto p-8">
  <h2 class="text-2xl font-semibold">Feed</h2>

  <div class="p-4 rounded border shadow-xl border-gray-200">
    <%= form_with(model: @tweet, class: "space-y-4") do |f| %>
      <%= render "shared/form_errors", object: @tweet %>

      <%= f.text_area :body, rows: 3, class: "w-full p-2 border border-gray-200 rounded resize-none", placeholder: "What's happening?" %>

      <div class="flex justify-end">
        <%= f.submit "Tweet", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 cursor-pointer" %>
      </div>
    <% end %>

  </div>

  <div id="tweets" class="space-y-4 my-8">
    <% @tweets.each do |tweet| %>
      <%= render tweet %>
    <% end %>
  </div>

</main>