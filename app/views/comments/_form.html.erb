<%= form_with(model: [tweet, comment], id: dom_id(tweet, :comment_form) , class: "mt-4")  do |f| %>
  <%= f.text_area :content, placeholder: "Add a comment...", class: "w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
  <%= f.submit class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 cursor-pointer" %>
<% end %>