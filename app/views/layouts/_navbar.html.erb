<header class="bg-gray-200 shadow-2xl">
  <nav class="w-full max-w-7xl mx-auto flex items-center justify-between p-4">
    <%= link_to "temuTwitter", root_path, class: "text-2xl font-semibold" %>
    <ul>
      <% if authenticated? %>
       <%= link_to "Sign Out", session_path, data: { turbo_method: :delete }, class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 cursor-pointer" %>
      <% else %>
        <%= link_to "Sign In", new_session_path, class: "border border-blue-500 text-blue-500 px-4 py-2 rounded hover:text-white hover:bg-blue-600 cursor-pointer" %>
        <%= link_to "Sign Up", new_user_path, class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 cursor-pointer" %>
      <% end %>
    </ul>
  </nav>
</header>